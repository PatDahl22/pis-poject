{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fall Alarm Event",
  "type": "object",
  "required": ["device_id", "event", "severity", "ts"],
  "properties": {
    "device_id": {
      "type": "string"
    },
    "event": {
      "type": "string",
      "enum": ["fall_detected", "heartbeat", "reset"]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "pulse": {
      "type": ["number", "integer", "null"]
    },
    "spo2": {
      "type": ["number", "integer", "null"]
    },
    "temperature": {
      "type": ["number", "null"]
    },
    "ts": {
      "type": "string"
    }
  }
}
